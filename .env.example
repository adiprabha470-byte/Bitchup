# Hosting platforms normally inject PORT. Node does not load this file automatically.
PORT=3000
NODE_ENV=production
# Optional comma-separated exact public origins. With no value, only same-host origins are allowed.
# ALLOWED_ORIGINS=https://bitchup.example.com
# Optional durable single-instance snapshots. Keep directory private; includes reconnect credentials.
# ROOM_STORE_PATH=./data/rooms.json
